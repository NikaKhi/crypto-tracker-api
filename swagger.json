{
  "openapi": "3.0.0",
  "info": {
    "title": "Crypto Tracker API",
    "version": "1.0.0",
    "description": "API for tracking cryptocurrency prices"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Check server status",
        "responses": {
          "200": {
            "description": "Server is running"
          }
        }
      }
    },
    "/api/cryptos": {
      "get": {
        "summary": "Get all tracked cryptocurrencies",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of cryptocurrencies"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Add a new cryptocurrency to track",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "example": "BTC"
                  },
                  "name": {
                    "type": "string",
                    "example": "Bitcoin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/cryptos/{id}/history": {
      "get": {
        "summary": "Get price history for a cryptocurrency",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price history"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/cryptos/{id}": {
      "delete": {
        "summary": "Delete a cryptocurrency from tracking",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}